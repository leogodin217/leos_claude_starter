#!/usr/bin/env bash
# Spawn and drive named, remote-controllable claude sessions in detached tmux
# panes. Sessions survive the operator session that spawned them (tmux server
# process) and are reachable directly from claude.ai (/remote-control).
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
usage: rsession <command> [args]

  spawn <name> <dir> [prompt...]  start claude in <dir>, register /remote-control <name>,
                                  print the claude.ai URL, then send [prompt] if given
  peek  <name> [lines]            show the session's screen (lines = scrollback depth)
  send  <name> <text...>          type text into the session and press Enter
  state <name>                    print busy | background | dialog | idle | exited | gone
  wait  <name> [timeout-secs]     block until the session needs input; print why
                                  (idle=0, dialog=2, exited/gone=3, timeout=124)
  ls                              list rsession/remote-claude tmux sessions
  kill  <name>                    kill the session

Sessions are named claude-<name>. If <dir>/.claude/*-system-prompt.md exists,
it is passed as --system-prompt-file (repo convention); otherwise plain claude.
EOF
    exit 1
}

[ $# -ge 1 ] || usage
cmd="$1"
shift

pane() { tmux capture-pane -pt "claude-$1" ${2:+-S "-$2"}; }

# Classify a session from its screen. Only the bottom of the screen is read, so
# finished output higher up cannot look busy; the input line is never read for
# content (it may hold the TUI's ghost-text suggestion).
state() {
    local session="claude-$1" bottom
    tmux has-session -t "=$session" 2>/dev/null || { echo gone; return; }
    [ "$(tmux display -p -t "$session" '#{pane_dead}')" = 1 ] && { echo exited; return; }
    bottom="$(pane "$1" | grep -v '^[[:space:]]*$' | tail -15)"
    if grep -qE 'Enter to select|Esc to cancel|Do you want to' <<<"$bottom"; then
        echo dialog    # AskUserQuestion or a permission prompt
    elif grep -qE '…[[:space:]]*\([0-9]+[ms]' <<<"$bottom"; then
        echo busy      # spinner or running tool: "Zesting… (3m 12s ·", "cmd… (13s ·"
    elif grep -qE '· [0-9]+ (shells?|agents?|tasks?|monitors?)\b' <<<"$bottom"; then
        echo background  # turn ended but background work will wake it: "· 1 shell"
    else
        echo idle
    fi
}

case "$cmd" in
spawn)
    [ $# -ge 2 ] || usage
    name="$1"
    dir="$(cd "$2" && pwd)"
    shift 2
    session="claude-$name"
    if tmux has-session -t "=$session" 2>/dev/null; then
        echo "error: session $session already exists (rsession peek $name, or kill it first)" >&2
        exit 1
    fi
    claude_bin="$(command -v claude)"
    sysprompt=""
    for f in "$dir"/.claude/*-system-prompt.md; do
        [ -e "$f" ] && sysprompt="$f" && break
    done
    if [ -n "$sysprompt" ]; then
        tmux new-session -d -s "$session" -c "$dir" -x 200 -y 50 \
            "$claude_bin" --dangerously-skip-permissions --system-prompt-file "$sysprompt"
    else
        tmux new-session -d -s "$session" -c "$dir" -x 200 -y 50 \
            "$claude_bin" --dangerously-skip-permissions
    fi
    tmux set-window-option -t "$session" remain-on-exit on

    # Wait for the TUI to be ready; answer the first-run folder-trust prompt
    # (spawning here deliberately implies trusting the target directory)
    ready=0
    for _ in $(seq 1 30); do
        sleep 1
        if pane "$name" | grep -q "trust this folder"; then
            tmux send-keys -t "$session" Enter
            continue
        fi
        pane "$name" | grep -q "bypass permissions" && { ready=1; break; }
    done
    if [ "$ready" -ne 1 ]; then
        echo "error: claude TUI not ready after 30s; inspect with: rsession peek $name" >&2
        exit 1
    fi

    # Register for remote control and capture the claude.ai URL
    tmux send-keys -t "$session" -l -- "/remote-control $name"
    sleep 0.5
    tmux send-keys -t "$session" Enter
    url=""
    for _ in $(seq 1 30); do
        sleep 1
        url="$(pane "$name" | grep -o 'https://claude\.ai/code/[A-Za-z0-9_]*' | tail -1)" && [ -n "$url" ] && break
    done

    echo "spawned $session in $dir"
    if [ -n "$url" ]; then
        echo "  remote-control: $url"
    else
        echo "  WARNING: /remote-control URL not detected — inspect with: rsession peek $name" >&2
    fi

    if [ $# -ge 1 ]; then
        tmux send-keys -t "$session" -l -- "$*"
        sleep 0.5
        tmux send-keys -t "$session" Enter
        echo "  sent: $*"
    fi
    echo "  peek: rsession peek $name    send: rsession send $name <text>    wait: rsession wait $name"
    ;;
peek)
    [ $# -ge 1 ] || usage
    pane "$1" "${2:-}"
    ;;
send)
    [ $# -ge 2 ] || usage
    name="$1"
    shift
    tmux send-keys -t "claude-$name" -l -- "$*"
    sleep 0.5
    tmux send-keys -t "claude-$name" Enter
    ;;
state)
    [ $# -ge 1 ] || usage
    state "$1"
    ;;
wait)
    # idle/dialog must hold for RSESSION_SETTLE polls (default 3, ~6s), so a
    # wait started right after `send` or a keypress doesn't return on the
    # screen from before the session picked the input up.
    [ $# -ge 1 ] || usage
    name="$1"
    timeout="${2:-1800}"
    settle="${RSESSION_SETTLE:-3}"
    start=$SECONDS
    prev=""
    same=0
    while :; do
        st="$(state "$name")"
        [ "$st" = "$prev" ] && same=$((same + 1)) || same=1
        prev="$st"
        case "$st" in
        gone | exited) echo "$st"; exit 3 ;;
        dialog) [ "$same" -ge "$settle" ] && { echo dialog; exit 2; } ;;
        idle) [ "$same" -ge "$settle" ] && { echo idle; exit 0; } ;;
        esac
        [ $((SECONDS - start)) -ge "$timeout" ] && { echo "timeout ($st)"; exit 124; }
        sleep 2
    done
    ;;
ls)
    tmux list-sessions -F '#{session_name}: #{session_path}' 2>/dev/null \
        | grep '^claude-' || echo "no claude tmux sessions"
    ;;
kill)
    [ $# -ge 1 ] || usage
    tmux kill-session -t "=claude-$1"
    ;;
*)
    usage
    ;;
esac
